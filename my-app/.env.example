# .env.example (safe to commit - contains no real secrets)

# Server-only database connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Third-party service API secret key (never expose to client)
API_SECRET_KEY=sk_test_your_key_here

# JWT signing secret for server authentication
JWT_SECRET=your_jwt_secret_here

# Stripe payments secret key for server-side processing
STRIPE_SECRET_KEY=sk_test_stripe_key_here

# Public base URL of the API (accessible in browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Public application display name
NEXT_PUBLIC_APP_NAME="My App"

# Stripe publishable key safe for client-side checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_stripe_key_here

# Google Analytics measurement ID safe for client telemetry
NEXT_PUBLIC_ANALYTICS_ID=GA-123456789
